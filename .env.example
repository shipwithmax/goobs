# ─────────────────────────────────────────────────────────────────
#   Goobs — environment config
# ─────────────────────────────────────────────────────────────────
#
#   Copy this file to `.env` (or run `./bin/vp init`) and change only
#   what you need. Goobs v0.1 runs entirely on your machine: no keys
#   are needed to transcribe, cut, polish or render.
#

# ── WHERE YOUR VIDEOS LIVE ───────────────────────────────────────
#   Default: ./hangar (next to this repo). Each video gets its own
#   folder, e.g. hangar/Y26-04-25-my-first-video/.
PROJECTS_ROOT=./hangar


# ── TRANSCRIPTION (local Whisper via whisper.cpp) ─────────────────
#   Needs `whisper-cli` on your PATH (macOS: brew install whisper-cpp).
#   The model downloads once to ~/.cache/goobs/whisper/.
#     tiny.en  ~75 MB   fastest, rough timing
#     base.en  ~148 MB  fast
#     small.en ~488 MB  default, good word timing
#     medium.en ~1.5 GB slower, more accurate
#   You can also point WHISPER_MODEL at any ggml .bin file.
TRANSCRIBER=whisper-cpp
WHISPER_MODEL=small.en
WHISPER_LANGUAGE=en
# WHISPER_CPP_BIN=/path/to/whisper-cli


# ── MOTION GRAPHICS (vp enrich, beta) ─────────────────────────────
#   HyperFrames version used by `vp enrich`. 0.7.18 is the version
#   Goobs is tested against. Goobs turns HyperFrames telemetry off.
HYPERFRAMES_VERSION=0.7.18


# ── LOG LEVEL ────────────────────────────────────────────────────
#   debug | info | warn | error
LOG_LEVEL=info


# ── PLANNED (not used in v0.1, see the README roadmap) ────────────
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# ZERNIO_API_KEY=
# ANTHROPIC_API_KEY=
# SCHEDULE_AUTO_PUBLISH=false
