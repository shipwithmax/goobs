{
  "name": "goobs",
  "version": "0.1.0",
  "description": "Local-first, agent-friendly video editing for people who talk for a living: transcribe with local Whisper, cut the radio version, render masters.",
  "license": "MIT",
  "author": "Max Palmer (https://github.com/shipwithmax)",
  "homepage": "https://github.com/shipwithmax/goobs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipwithmax/goobs.git"
  },
  "bugs": {
    "url": "https://github.com/shipwithmax/goobs/issues"
  },
  "keywords": [
    "video",
    "editor",
    "agent",
    "claude-code",
    "hyperframes",
    "whisper",
    "whisper.cpp",
    "ffmpeg",
    "transcription",
    "rough-cut"
  ],
  "type": "module",
  "engines": {
